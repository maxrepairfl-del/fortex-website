{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "fortex-website-five.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/oven-stove-repair",
      "destination": "/services/oven-repair/",
      "permanent": true
    },
    {
      "source": "/services/oven-stove-repair/",
      "destination": "/services/oven-repair/",
      "permanent": true
    },
    {
      "source": "/areas/irvine",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/irvine/",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/huntington-beach",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/huntington-beach/",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/anaheim",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/anaheim/",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/santa-ana",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/santa-ana/",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/yorba-linda",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/yorba-linda/",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/fountain-valley",
      "destination": "/areas/",
      "permanent": true
    },
    {
      "source": "/areas/fountain-valley/",
      "destination": "/areas/",
      "permanent": true
    }
  ]
}
